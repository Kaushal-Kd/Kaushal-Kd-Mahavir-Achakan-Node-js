{
  "name": "@wrs/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Achakan — Electron + React (JSX) desktop application.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test \"src/**/*.test.js\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"npm:dev\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build:win": "vite build && electron-builder --win --x64",
    "build:portable": "vite build && electron-builder --win portable",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@wrs/shared": "*",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.7.2",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.11",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.400.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.24.0",
    "recharts": "^3.8.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.2",
    "wait-on": "^7.2.0"
  }
}
